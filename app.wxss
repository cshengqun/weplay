/* app.wxss - 全局样式 */
page {
  background: #F3F6F4;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #1F2D27;
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  padding: 24rpx 32rpx 160rpx;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(23, 78, 51, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  color: #1F2D27;
}

/* 按钮 */
.btn {
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  line-height: 1.4;
}
.btn::after {
  border: none;
}
.btn-primary {
  background: #1B7A4B;
  color: #FFFFFF;
}
.btn-primary.btn-disabled {
  background: #A8C8B6;
  color: #FFFFFF;
}
.btn-ghost {
  background: #FFFFFF;
  color: #1B7A4B;
  border: 2rpx solid #1B7A4B;
}
.btn-danger {
  background: #FFFFFF;
  color: #D64B4B;
  border: 2rpx solid #D64B4B;
}
.btn-small {
  display: inline-block;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
}

/* 标签 */
.tag {
  display: inline-block;
  background: #EAF4EE;
  color: #1B7A4B;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}
.tag-gray {
  background: #F0F2F1;
  color: #6B7A72;
}
.tag-red {
  background: #FDEEEE;
  color: #D64B4B;
}
.tag-orange {
  background: #FDF3E7;
  color: #C77A1E;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 60rpx;
}
.empty-badge {
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: #EAF4EE;
  color: #1B7A4B;
  font-size: 56rpx;
  font-weight: 700;
}
.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #4A5A51;
  margin-bottom: 12rpx;
}
.empty-sub {
  font-size: 26rpx;
  color: #8A9890;
}

/* 表单 */
.form-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F0F2F1;
}
.form-row:last-child {
  border-bottom: none;
}
.form-label {
  width: 160rpx;
  color: #4A5A51;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
}

/* 步进器 */
.stepper {
  display: inline-flex;
  align-items: center;
  background: #F0F2F1;
  border-radius: 999rpx;
}
.stepper-btn {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  color: #1B7A4B;
  font-weight: 600;
}
.stepper-btn.disabled {
  color: #B9C4BE;
}
.stepper-num {
  min-width: 64rpx;
  text-align: center;
  font-weight: 600;
  font-size: 30rpx;
}

/* 顶部块 */
.page-head {
  margin-bottom: 24rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2D27;
}
.page-sub {
  font-size: 26rpx;
  color: #7C8B83;
  margin-top: 6rpx;
}

/* 底部操作栏 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(23, 78, 51, 0.08);
  display: flex;
  gap: 20rpx;
  z-index: 10;
}
.footer-bar .btn {
  flex: 1;
}
