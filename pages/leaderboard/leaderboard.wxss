/* 全国段位榜页面专用样式（全局 page/card/empty 在 app.wxss） */

/* 加载错误提示 */
.lb-error {
  background: #FFF4E5;
  color: #B45309;
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  line-height: 1.5;
}
.lb-note {
  font-size: 22rpx;
  color: #8A9890;
}

/* ---------- 段位配色 ---------- */
.tier-qingyu { color: #4E7A68; background: #EAF2EE; }
.tier-baiyu { color: #6B7A74; background: #EEF1F0; }
.tier-jinyu { color: #A8761B; background: #FBF1DC; }
.tier-feicui { color: #15805F; background: #E4F4ED; }
.tier-zuanshi { color: #3563C4; background: #E8EFFB; }
.tier-xingyao { color: #7447BC; background: #F1EAFB; }
.tier-qiuwang,
.tier-chuanqi {
  color: #C23B3B;
  background: #FCEBEA;
}
.tier-qiuwang.king,
.tier-chuanqi.king {
  font-weight: 700;
}

/* ---------- 我的段位卡 ---------- */
.my-tier {
  margin-bottom: 24rpx;
}
.mt-head {
  display: flex;
  align-items: center;
}
.mt-avatar,
.mt-avatar-ph {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #E5E6EB;
}
.mt-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5B6B62;
  font-size: 36rpx;
}
.mt-id {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.mt-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #274639;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mt-tiername {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}
.mt-elo {
  text-align: right;
  flex-shrink: 0;
}
.mt-elonum {
  font-size: 40rpx;
  font-weight: 700;
  color: #1B7A4B;
  line-height: 1.1;
}
.mt-elolabel {
  font-size: 20rpx;
  color: #8A9890;
  margin-top: 6rpx;
}
.mt-sub {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F0F2F1;
  font-size: 24rpx;
  color: #5B6B62;
}
.my-empty-card .mt-empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8A9890;
  line-height: 1.6;
}

/* ---------- 段位榜 ---------- */
.nb-head,
.nb-row {
  display: flex;
  align-items: center;
}
.nb-row {
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F0F2F1;
}
.nb-row:last-child {
  border-bottom: none;
}
.nb-row.top {
  background: #F7FAF8;
}
.nb-head {
  font-size: 22rpx;
  color: #8A9890;
  border-bottom: 2rpx solid #E3EBE6;
}
.nb-c1 {
  flex-shrink: 0;
  width: 52rpx;
  text-align: center;
  font-size: 26rpx;
}
.nb-c1.rank {
  color: #1B7A4B;
  font-weight: 700;
}
.nb-c2 {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.nb-player {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}
.nb-avatar,
.nb-avatar-ph {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #E5E6EB;
}
.nb-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5B6B62;
  font-size: 20rpx;
  margin-right: 10rpx;
}
.nb-avatar {
  margin-right: 10rpx;
}
.nb-name {
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.nb-c3 {
  flex-shrink: 0;
  width: 168rpx;
  text-align: center;
}
.nb-tier {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
.nb-sub {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #8A9890;
}
.nb-c4 {
  flex-shrink: 0;
  width: 80rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 600;
  color: #1B7A4B;
}

/* ---------- 历史回溯入口 ---------- */
.rebuild {
  text-align: center;
  font-size: 22rpx;
  color: #8A9890;
  padding: 24rpx 0;
}
