/* 比分进度提示 */
.progress-tip {
  margin-top: 20rpx;
  background: #FFF8E6;
  color: #A16207;
  font-size: 24rpx;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.5;
}

/* 待我确认提示条 */
.todo-bar {
  background: #FDF3E7;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.todo-text {
  color: #C77A1E;
  font-size: 26rpx;
  font-weight: 600;
}

/* 单场结果确认 */
.mcf {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed #E3EBE6;
}
.mcf-state {
  font-size: 22rpx;
  text-align: center;
}
.mcf-state.mcf-pending {
  color: #C77A1E;
}
.mcf-state.mcf-disputed {
  color: #D64B4B;
  font-weight: 600;
}
.mcf-state.mcf-confirmed {
  color: #1B7A4B;
}
.mcf-btns {
  display: flex;
  margin-top: 12rpx;
}
.mcf-btn {
  flex: 1;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 10rpx 0;
  line-height: 1.5;
  margin: 0;
}
.mcf-btn::after {
  border: none;
}
.mcf-btn.ok {
  background: #1B7A4B;
  color: #FFFFFF;
  margin-right: 16rpx;
}
.mcf-btn.no {
  background: #FDEEE9;
  color: #C75A3A;
}
.mcf-wait {
  font-size: 22rpx;
  color: #8A9890;
  text-align: center;
  margin-top: 8rpx;
}
